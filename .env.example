# Ollama stays local. Do not expose port 11434 to the internet.
AI_PROVIDER=ollama
AI_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_NUM_CTX=4096
AI_TIMEOUT_MS=65000
AI_RETRY_COUNT=1
AI_MAX_OUTPUT_TOKENS=600
# Structured RAG is much faster on small CPU models without extended thinking.
AI_ANSWER_THINK=false
AI_ANSWER_MAX_OUTPUT_TOKENS=220
RAG_RESPONSE_MODE=hybrid
# Keep intake deterministic by default so an ambiguous phrase cannot become a made-up clothing journey.
INTENT_AI_ENABLED=false
INTAKE_SLOT_AI_ENABLED=false
# smart skips Ollama for project descriptions already understood by deterministic parsing.
EXPLORATION_AI_MODE=smart

# demo shows clearly-labelled draft evidence. Set production to exclude pending evidence.
KNOWLEDGE_MODE=demo
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

# Local demo authentication. Change all three values before any shared deployment.
AUTH_SECRET=replace-with-a-long-random-local-secret
DEMO_USERNAME=demo
DEMO_PASSWORD=demo1234
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@lifeevent.local
# Set a unique password of at least 12 characters before running npm run db:admin.
ADMIN_PASSWORD=

# MongoDB is required for accounts, history, and checklist progress.
# Start a local MongoDB service, or replace this with your own connection URL.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=lifeevent_ai
MONGODB_CONNECT_TIMEOUT_MS=2500
